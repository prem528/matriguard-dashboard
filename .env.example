# Copy to .env.local (dev), or enter in hPanel > Node.js app > Environment
# variables (production). Never commit the real values.

# The one admin login. Generate the hash and secret with:
#   node scripts/hash-password.mjs "your-long-password"
ADMIN_EMAIL=admin@matriguardsolutions.com
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Optional: how the panel greets you. Defaults to the part of the email before @.
ADMIN_NAME=

# MySQL (hPanel > Databases). On Hostinger itself the host is 127.0.0.1.
# From your own computer, add your IP under Databases > Remote MySQL and use
# the hostname shown there instead.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u319046606_matriguard_db
DB_USER=
DB_PASSWORD=

# The public website, for "View on site" links and previews of the covers it hosts.
SITE_URL=https://matriguardsolutions.com
